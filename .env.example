# Variables de entorno para ejecucion local y despliegue PaaS en Render (Guia 3)
# Copia este archivo como .env (en local) o cargalas en Render Environment (NUNCA subas secretos reales a Git).

# Base de datos MySQL (Local: localhost / 3306 / DISABLED | Aiven remoto: host Aiven / puerto / REQUIRED)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=crud_usuarios
DB_USERNAME=root
DB_PASSWORD=
DB_SSL_MODE=REQUIRED

# Servidor SMTP de correo (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Gestion de Usuarios

# Seguridad JWT (minimo 32 bytes aleatorios en Base64; en Render Blueprint se autogenera)
JWT_SECRET=ZGV2ZWxvcG1lbnQtb25seS1qd3Qtc2VjcmV0LW11c3QtYmUtcmVwbGFjZWQ=
JWT_EXPIRATION_SECONDS=900

# Variables de entorno para ejecucion local, TiDB Cloud, Brevo y Render PaaS (Guia 5)
# Copia este archivo como .env (en local) o cargalas en Render Environment (NUNCA subas secretos reales a Git).

# Base de datos MySQL / TiDB Cloud
# - Local: localhost / 3306 / root / DISABLED
# - Aiven: <host>.aivencloud.com / <puerto> / avnadmin / REQUIRED
# - TiDB Cloud: gateway01.<region>.prod.aws.tidbcloud.com / 4000 / <id>.root / VERIFY_IDENTITY
DB_HOST=<tu-gateway>.tidbcloud.com
DB_PORT=4000
DB_NAME=crud_usuarios
DB_USERNAME=<tu-usuario>.root
DB_PASSWORD=
DB_SSL_MODE=VERIFY_IDENTITY

# API transaccional de Brevo (REST HTTPS /v3/smtp/email - sustituye SMTP bloqueado en Render Free)
BREVO_API_KEY=xkeysib-REEMPLAZAR
BREVO_FROM_ADDRESS=remitente-verificado@example.com
BREVO_FROM_NAME=Gestion de Usuarios

# Seguridad JWT (minimo 32 bytes aleatorios en Base64; en Render Blueprint se autogenera)
JWT_SECRET=REEMPLAZAR_CON_BASE64_DE_32_BYTES
JWT_EXPIRATION_SECONDS=900

# Variables de entorno para ejecucion local y conexion remota (Guia 2: Aiven MySQL + SSL)
# Copie este archivo como .env y complete con sus valores reales (NUNCA suba .env a Git)

# Base de datos MySQL (Local: localhost / 3306 / DISABLED | Aiven remoto: host Aiven / puerto / REQUIRED)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=crud_usuarios
DB_USERNAME=root
DB_PASSWORD=
DB_SSL_MODE=REQUIRED

# Servidor SMTP de correo (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Gestion de Usuarios
